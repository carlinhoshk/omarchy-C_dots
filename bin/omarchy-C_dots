#!/usr/bin/env bash
set -euo pipefail

APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
LIB_DIR="$APP_DIR/lib"
source "$LIB_DIR/common.sh"
source "$LIB_DIR/manifest.sh"
source "$LIB_DIR/gist.sh"
source "$LIB_DIR/backup.sh"
source "$LIB_DIR/restore.sh"
trap cleanup_temp_dirs EXIT

usage() {
  cat <<'EOF'
Uso: omarchy-C_dots <comando> [opções]

Comandos:
  status                 Mostra autenticação, manifesto e backup recente
  setup [--gist ID|URL]  Cria ou associa um Gist
  manifest list          Lista arquivos e pastas selecionados
  manifest add CAMINHO   Inclui arquivo ou pasta específica de ~/.config
  manifest remove CAMINHO
  backup [--dry-run]     Atualiza o Gist ou apenas mostra a prévia
  restore [--gist ID] [--dry-run] [--yes]

As pastas do manifesto são percorridas recursivamente.
EOF
}

if (($# == 0)); then usage; exit 2; fi
command="$1"; shift
case "$command" in
  status) dots_status "$@" ;;
  setup) dots_setup "$@" ;;
  manifest)
    (($#)) || die "Informe uma ação para manifest: list, add ou remove."
    action="$1"; shift
    dots_manifest "$action" "$@"
    ;;
  backup) dots_backup "$@" ;;
  restore) dots_restore "$@" ;;
  -h|--help|help) usage ;;
  *) die "Comando desconhecido: $command" ;;
esac
